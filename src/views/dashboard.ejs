<!DOCTYPE html>
<html>
<head>
  <title>Dashboard</title>
</head>
<body>

<h1>Skills</h1>

<form action="/api/v1/skills" method="POST">
  <input type="text" name="title" placeholder="Skill name" required />
  <input type="text" name="description" placeholder="Skill description" required />
  <button type="submit">Add Skill</button>
</form>

<ul>
  <% skills.forEach(skill => { %>
    <li>
      <%= skill.title %>

      <form action="/api/v1/skills/delete/<%= skill.id %>" method="POST" style="display:inline;">
        <button type="submit">Delete</button>
      </form>
    </li>
  <% }) %>
</ul>

</body>
</html>
